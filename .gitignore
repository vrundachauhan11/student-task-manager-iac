# =======================================================
# Terraform Ignored Files
# =======================================================
# Local .terraform directories
.terraform/
**/.terraform/
**/.terraform/*

# .tfstate and plan files
*.tfstate
*.tfstate.*
*.tfplan
*.plan

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files with potential sensitive variables
*.tfvars
*.tfvars.json
*.auto.tfvars
*.auto.tfvars.json

# Allow example tfvars files
!terraform.tfvars.example
!*.example.tfvars


# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# =======================================================
# Environment & Secrets
# =======================================================
.env
.env.*
*.pem
*.key
*.secret

# =======================================================
# Node / Dependencies / Logs
# =======================================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# =======================================================
# Operating System & IDE Files
# =======================================================
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
